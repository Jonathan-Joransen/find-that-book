{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenLibrary": {
    "BaseUrl": "https://openlibrary.org/",
    "SearchLimit": 25,
    "SearchCacheDurationMinutes": 360,
    "RetryCount": 2,
    "RetryDelayMilliseconds": 250,
    "UserAgent": "FindThatBook/1.0"
  },
  "BookSearch": {
    "CacheDurationMinutes": 60
  },
  "Gemini": {
    "Model": "gemini-3.7-flash"
  },
  "AllowedHosts": "*"
}
